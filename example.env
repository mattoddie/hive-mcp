# Copy to .env and fill in:  cp example.env .env
# Every option is explained in docs/configuration.md

# --- Hive account -------------------------------------------------------------
# The email address and password you use in the Hive app. The password is
# needed for `hive-mcp login`, and later so the server can log in again by
# itself (as a remembered device, without an SMS code) when its login runs out.
HIVE_USERNAME=
HIVE_PASSWORD=

# The login (tokens and this server's remembered-device secret) is saved here
# after `hive-mcp login`. The image uses /data/tokens.json; keep /data on a volume.
# HIVE_TOKEN_FILE=/data/tokens.json
# How this server appears in your Hive account's list of remembered devices.
# HIVE_DEVICE_NAME=hive-mcp

# Register tools that change things: heating temperature and mode, boosts,
# hot water, holiday mode, plugs and lights.
HIVE_ALLOW_WRITES=false
# Register hive_auth_start and hive_auth_complete, so the assistant can log in
# for you (they use HIVE_PASSWORD and can make Hive text an SMS code).
# Off by default: `hive-mcp login` in a terminal is the usual way.
# HIVE_ALLOW_LOGIN_TOOLS=false
# The highest heating target (°C) any tool will set, 5 to 32 (default 25).
# HIVE_MAX_TEMP=25
# Record every change the assistant makes (and every login it starts) as JSON
# lines: a file path (its directory must exist; in Docker, mount a writable
# volume) or stderr. Off when empty.
# HIVE_AUDIT_LOG=/audit/hive-mcp.jsonl
# Comma-separated toolsets to expose (default all). Fewer tools = less context for the model.
# home,heating,hotwater,devices,raw. "all" is every toolset except raw (the raw
# API tool), which you have to list by name, e.g. all,raw.
HIVE_TOOLSETS=all
# How long a reading of the home is reused before asking Hive again (0 turns the cache off).
HIVE_CACHE_SECONDS=30
HIVE_TIMEOUT_MS=30000

# --- MCP transport ------------------------------------------------------------
# The image defaults to http. Use stdio for `docker run -i` from an MCP client.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Required for http (the server refuses to start without it): clients must send
# "Authorization: Bearer <token>".  Generate one with: openssl rand -hex 32
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional comma-separated Host header allow-list (DNS rebinding protection).
MCP_ALLOWED_HOSTS=
