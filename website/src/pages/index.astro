          <line x1="756" y1="140" x2="756" y2="168" stroke="#6b5b50" stroke-width="2" />
          <ellipse cx="756" cy="200" rx="70" ry="44" fill="url(#glow-g)" opacity="0.6" />
          <path d="M738 182 L744 166 H768 L774 182 Z" fill="#f59e0b" />
