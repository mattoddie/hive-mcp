---
import logo from "../../../docs/assets/logo.svg?raw";
import { prompts, toolsets, totals } from "../lib/tools";

const GITHUB = "https://github.com/mattoddie/hive-mcp";
const title = "hive-mcp: talk to your Hive heating";
const description =
  "An unofficial, open-source MCP server for Hive smart heating. Ask Claude and other AI assistants how warm the house is, and let them boost the heating, put the hot water on or set holiday mode when you allow it. Runs in Docker.";

const toolsetIcons: Record<string, string> = {
  home: "🏠",
  heating: "🔥",
  hotwater: "🛁",
  devices: "💡",
  raw: "🧪",
};

const examples = [
  { icon: "🌡️", q: "How warm is each room right now?", tools: ["get_overview", "get_heating"] },
  { icon: "🔥", q: "Boost the heating to 21 for an hour.", tools: ["get_heating", "boost_heating"] },
  { icon: "🛁", q: "Put the hot water on, I want a bath.", tools: ["get_hot_water", "boost_hot_water"] },
  { icon: "🧳", q: "We're away until the 28th. Set holiday mode.", tools: ["get_overview", "set_holiday_mode", "set_plug"] },
  { icon: "🔋", q: "Which Hive devices need new batteries?", tools: ["list_devices", "list_trvs"] },
  { icon: "📅", q: "Is my heating schedule wasting energy?", tools: ["get_heating_schedule", "get_hot_water_schedule"] },
];

const features = [
  {
    icon: "🐳",
    title: "Docker-first",
    text: "A ~20 MB distroless image for amd64 and arm64. It runs as non-root on a read-only filesystem, and only the login volume is writable.",
  },
  {
    icon: "📱",
    title: "One SMS code, once",
    text: "Log in once with the code Hive texts you. The server registers itself as a remembered device, so it logs in again on its own, with no more codes.",
  },
  {
    icon: "🔐",
    title: "Real Cognito SRP",
    text: "It logs in the way the Hive app does, proving your password without sending it, checked against the maths of the client Home Assistant uses.",
  },
  {
    icon: "🌡️",
    title: "Validated changes",
    text: "Targets of 5–25 °C in steps of 0.5 (HIVE_MAX_TEMP), boosts of up to six hours, holiday mode of up to 60 days, a confirmation for anything left on indefinitely, and brightness and colour within each bulb's range. Bad values never reach Hive.",
  },
  {
    icon: "🐢",
    title: "Gentle on Hive",
    text: "Readings are cached for 30 seconds, rate limits are retried with back-off, and a failed login is never hammered.",
  },
  {
    icon: "🧪",
    title: "Tested against a mock Hive",
    text: "The suite runs every tool against a fake Hive, including a Cognito that checks each SRP proof, SMS code and remembered device.",
  },
];

const coverage = ["Hive thermostats", "Multi-zone heating", "Radiator valves (TRVs)", "Hot water", "Holiday mode", "Smart plugs", "Active lights", "Window & door sensors"];
const clients = ["Claude Code", "Claude Desktop", "VS Code", "Cursor", "Codex", "Any MCP client"];

// Falling snow behind the hero, and pines in the garden of the illustrated house.
const flakes = Array.from({ length: 36 }, (_, i) => ({
  x: Math.round((i * 157.3) % 1440),
  r: 1 + (i % 3) * 0.7,
  dur: 10 + ((i * 7) % 9),
  delay: -((i * 3.7) % 18).toFixed(1),
}));
const trees = [
  { x: 70, s: 0.8 },
  { x: 170, s: 1.1 },
  { x: 268, s: 0.9 },
  { x: 1330, s: 0.95 },
  { x: 1410, s: 0.7 },
];

const raw = GITHUB.replace("github.com", "raw.githubusercontent.com");
const composeSnippet = `mkdir hive-mcp && cd hive-mcp
curl -fsSLO ${raw}/main/compose.yaml
curl -fsSL ${raw}/main/example.env -o .env
# set HIVE_USERNAME, HIVE_PASSWORD
# and MCP_AUTH_TOKEN in .env
docker compose run --rm hive-mcp login
docker compose up -d`;
const connectSnippet = `claude mcp add --transport http hive \\
  http://<docker-host>:8080/mcp \\
  --header "Authorization: Bearer <token>"`;
---

<!doctype html>
<html lang="en">
