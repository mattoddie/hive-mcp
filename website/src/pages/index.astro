          <path class="pipe-hot" d="M932 222 V309 H403 V302" fill="none" stroke="#fb923c" stroke-width="5" stroke-linejoin="round" stroke-dasharray="10 8" />
          <path d="M966 200 H986" stroke="#4b5563" stroke-width="5" />
