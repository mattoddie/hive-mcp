          <rect x="662" y="266" width="188" height="30" rx="8" fill="#b45309" />
          <rect x="652" y="250" width="26" height="48" rx="10" fill="#7c2d12" /><rect x="834" y="250" width="26" height="48" rx="10" fill="#7c2d12" />
          <rect x="690" y="240" width="46" height="30" rx="8" fill="#fbbf24" opacity="0.85" />
